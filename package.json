{
  "name": "web-utilities",
  "version": "1.0.0",
  "description": "Private, browser-based tools for everyday web tasks: QR codes, image and PDF conversion, passwords, hashing, formatters, and more.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "utilities",
    "qr-code",
    "pdf",
    "image-converter",
    "privacy",
    "client-side",
    "vanilla-js"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "check": "npm run lint && npm run format:check && npm run vendor:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/nunito": "5.3.0",
    "eslint": "^10.14.0",
    "globals": "^15.15.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.10.0",
    "qrcode-generator": "2.0.4"
  }
}
